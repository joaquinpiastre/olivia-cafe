# ── Base de datos (PostgreSQL en Railway) ──────────────────────────────
# Railway → servicio Postgres → Variables → DATABASE_PUBLIC_URL (sirve para Vercel y para correr local)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# ── Sesión del panel admin ─────────────────────────────────────────────
# Cadena aleatoria larga. Generala con:  openssl rand -base64 48
AUTH_SECRET="cambiar-por-una-cadena-aleatoria-larga"

# ── Sitio ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://oliviapasteleria.com.ar"
# Número de WhatsApp en formato internacional, sin + ni espacios (Argentina móvil: 549 + código de área + número)
NEXT_PUBLIC_WHATSAPP_NUMBER="5492617148842"
# "true" cuando el sitio esté listo para que Google lo indexe (mientras tanto queda con noindex)
NEXT_PUBLIC_ALLOW_INDEXING="false"

# ── Solo para `npm run db:seed` (crea el primer usuario admin) ─────────
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
